INSTALL_DIR=/opt/eclipse
WD_TMP_FILE=/tmp/watchdog
REFRESH_TIME=5
TIMEOUT_TIME=300
# Kura 6 uses systemd watchdog (sd_notify) by default. Systemd PID1 must
# manage the hardware watchdog so that multiple services can share the
# resource. This drop-in enables RuntimeWatchdogSec at PID1 level.
SYSTEMD_WATCHDOG_ENABLE_CONFIG="[Manager]
RuntimeWatchdogSec=60
RebootWatchdogSec=60
KExecWatchdogSec=60
"
# Legacy config from Kura <=5 that disabled systemd watchdog.
# Must be removed on install to prevent conflicts.
SYSTEMD_WATCHDOG_DISABLE_FILE="zz-kura-disable-watchdog.conf"

##############################################
# UTILITY FUNCTIONS
##############################################
# Run preInstall function and start watchdog if needed
function runPreInstall {
    if [ -f "${WD_TMP_FILE}" ]; then
        WATCHDOG_DEVICE=`cat ${WD_TMP_FILE}`
        preInstall &
        PID=$!
        START=$(date +%s)
        
        while [ -d "/proc/$PID" ]; do
            echo w > ${WATCHDOG_DEVICE}
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
        stopWatchdog
    else
        preInstall &
        PID=$!
        START=$(date +%s)
        
        while [ -d "/proc/$PID" ]; do
            DELTA=$(($(date +%s) - $START))
            if [ "$DELTA" -ge "$TIMEOUT_TIME" ]; then
                echo "The installation process is not responding. It'll be stopped."
                kill -9 $PID >> /dev/null 2>&1
            fi
            sleep $REFRESH_TIME
        done
    fi
}

# Deactivate watchdog device if possible
function stopWatchdog {
    if [ -n "${WATCHDOG_DEVICE}" ]; then
        echo V > ${WATCHDOG_DEVICE}
    fi
}

function ensure_systemd_watchdog() {
    # Kura 6 uses systemd watchdog (sd_notify) by default.
    # Enable systemd's hardware watchdog management at PID1 level
    # so that /dev/watchdog is shared among all services.
    # Also remove any legacy disable config from Kura <=5.
    #
    # https://manpages.debian.org/testing/systemd/systemd-system.conf.5.en.html
    # /etc/systemd/system.conf.d/ is the admin-config path.
    #
    DROPDIR="/etc/systemd/system.conf.d"

    mkdir -p "${DROPDIR}"
    if [ ! -d "${DROPDIR}" ]; then
        echo "Failed to create systemd drop-in directory ${DROPDIR}"
        return 1
    fi

    # Remove legacy disable config from Kura <=5 in any of the three standard locations
    for dir in /usr/lib/systemd/system.conf.d /usr/local/lib/systemd/system.conf.d /etc/systemd/system.conf.d; do
        local legacy="${dir}/${SYSTEMD_WATCHDOG_DISABLE_FILE}"
        if [ -f "${legacy}" ]; then
            echo "Removing legacy systemd watchdog disable config: ${legacy}"
            rm -f "${legacy}"
        fi
    done

    # Enable systemd hardware watchdog for PID1
    echo "Enabling systemd hardware watchdog management (RuntimeWatchdogSec=60)"
    echo -e "${SYSTEMD_WATCHDOG_ENABLE_CONFIG}" > ${DROPDIR}/zz-kura-enable-watchdog.conf
    chmod 644 ${DROPDIR}/zz-kura-enable-watchdog.conf
    systemctl daemon-reload
    echo "Systemd watchdog configuration complete."
}

# Pre-install script
function preInstall {
    #clean up old installation if present
    rm -fr /opt/eclipse/kura* >> /tmp/kura_install.log 2>&1
    rm -fr ${INSTALL_DIR}/kura* >> /tmp/kura_install.log 2>&1
    rm -fr /tmp/.kura/ >> /tmp/kura_install.log 2>&1
    rm /var/log/kura.log >> /tmp/kura_install.log 2>&1
    rm -f kura-*.zip >> /tmp/kura_install.log 2>&1
    rm -f kura_*.zip >> /tmp/kura_install.log 2>&1
    echo ""
}
##############################################
# END UTILITY FUNCTIONS
##############################################

##############################################
# PRE-INSTALL SCRIPT
##############################################
PIDS=`pgrep java`

echo ""
echo "Installing Kura..."
echo "Installing Kura..." > /tmp/kura_install.log 2>&1

#Kill JVM and monit for installation
if [ -f "/var/run/kura.pid" ] ; then
  KURA_PID=`cat /var/run/kura.pid`

  for pid in "${PIDS[@]}"
  do
    if [ "$KURA_PID" == "$pid" ] ; then
      `kill $pid` >> /tmp/kura_install.log 2>&1
    fi
  done
fi

ensure_systemd_watchdog
runPreInstall
##############################################
# END PRE-INSTALL SCRIPT
##############################################

